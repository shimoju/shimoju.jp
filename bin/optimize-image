#!/bin/sh

set -eu

usage() {
  cat <<'EOF'
Usage: bin/optimize-image [--width PIXELS] [--format auto|png|jpeg] IMAGE...

Resize and optimize PNG, JPEG, and HEIC images. The default maximum width is
1800px. By default (--format auto), PNG inputs produce PNG and JPEG/HEIC inputs
produce JPEG. Use --format png or --format jpeg to select the output format.

PNG and JPEG inputs are updated in place when keeping their format. Otherwise,
the source is preserved and output is written next to it as BASENAME.png or
BASENAME.jpg.

Resizing uses Lanczos for JPEG output and Catrom for PNG output, regardless of
the input format. Images are never enlarged.

JPEG output is converted to sRGB, stripped of metadata, and encoded at quality
85 with mozjpeg. Transparent pixels are composited over white. PNG output uses
lossy palette quantization with pngquant, followed by oxipng optimization.
EOF
}

max_width=1800
output_format=auto

while [ "$#" -gt 0 ]; do
  case "$1" in
    -w | --width)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      max_width=$2
      shift 2
      ;;
    -f | --format)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      output_format=$2
      shift 2
      ;;
    -h | --help)
      usage
      exit
      ;;
    --)
      shift
      break
      ;;
    -*)
      usage >&2
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

case "$max_width" in
  '' | *[!0-9]* | 0)
    echo "optimize-image: width must be a positive integer: $max_width" >&2
    exit 2
    ;;
esac

case "$output_format" in
  auto | png | jpeg) ;;
  *)
    echo "optimize-image: format must be auto, png, or jpeg: $output_format" >&2
    exit 2
    ;;
esac

[ "$#" -gt 0 ] || { usage >&2; exit 2; }

temp_dir=$(mktemp -d "${TMPDIR:-/tmp}/optimize-image.XXXXXX")
cleanup() {
  rm -rf "$temp_dir"
}
trap cleanup 0
trap 'exit 1' 1 2 15

find_mozjpeg() {
  for candidate in \
    "${MOZJPEG_CJPEG:-}" \
    /opt/homebrew/opt/mozjpeg/bin/cjpeg \
    /usr/local/opt/mozjpeg/bin/cjpeg \
    cjpeg
  do
    [ -n "$candidate" ] || continue
    resolved=$(command -v "$candidate" 2>/dev/null || true)
    if [ -n "$resolved" ] && "$resolved" -version 2>&1 | grep -qi mozjpeg; then
      printf '%s\n' "$resolved"
      return
    fi
  done

  if command -v brew >/dev/null 2>&1; then
    mozjpeg_prefix=$(brew --prefix mozjpeg 2>/dev/null || true)
    candidate=${mozjpeg_prefix:+$mozjpeg_prefix/bin/cjpeg}
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return
    fi
  fi

  echo 'optimize-image: mozjpeg cjpeg not found; install it with: brew install mozjpeg' >&2
  exit 1
}

find_srgb_profile() {
  for candidate in \
    "${SRGB_ICC_PROFILE:-}" \
    '/System/Library/ColorSync/Profiles/sRGB Profile.icc' \
    '/Library/ColorSync/Profiles/sRGB Profile.icc' \
    /usr/share/color/icc/colord/sRGB.icc \
    /usr/share/color/icc/sRGB.icc
  do
    if [ -n "$candidate" ] && [ -f "$candidate" ]; then
      printf '%s\n' "$candidate"
      return
    fi
  done

  echo 'optimize-image: sRGB ICC profile not found; set SRGB_ICC_PROFILE' >&2
  exit 1
}

mozjpeg=
srgb_profile=

for input in "$@"; do
  case "$input" in
    *.png | *.PNG)
      input_format=png
      ;;
    *.jpg | *.JPG | *.jpeg | *.JPEG)
      input_format=jpeg
      ;;
    *.heic | *.HEIC)
      input_format=heic
      ;;
    *)
      echo "optimize-image: unsupported file type: $input" >&2
      exit 1
      ;;
  esac

  format=$output_format
  if [ "$format" = auto ]; then
    case "$input_format" in
      png) format=png ;;
      *) format=jpeg ;;
    esac
  fi

  if [ "$format" = "$input_format" ]; then
    output=$input
  else
    case "$format" in
      png) output=${input%.*}.png ;;
      jpeg) output=${input%.*}.jpg ;;
    esac
  fi

  dimensions=$(magick identify -ping -format '%w %h' "$input")
  input_width=${dimensions%% *}
  input_height=${dimensions#* }
  input_size=$(wc -c <"$input" | tr -d ' ')

  case "$format" in
    png)
      resized="$temp_dir/resized.png"
      optimized="$temp_dir/optimized.png"

      source=$input
      if [ "$input_format" != png ] || [ "$input_width" -gt "$max_width" ]; then
        # Keep the source ICC profile so pngquant can convert its colors to sRGB.
        magick "$input" -auto-orient \
          -filter Catrom -resize "${max_width}x>" "png:$resized"
        source=$resized
      fi

      pngquant \
        --force \
        --quiet \
        --speed 1 \
        --quality 85-100 \
        --output "$optimized" \
        -- "$source"
      oxipng --quiet -o 4 --strip safe --alpha "$optimized"
      ;;
    jpeg)
      [ -n "$mozjpeg" ] || mozjpeg=$(find_mozjpeg)
      optimized="$temp_dir/optimized.jpg"
      icc_profile=$(magick identify -format '%[profile:icc]' "$input" 2>/dev/null || true)

      if [ -n "$icc_profile" ]; then
        [ -n "$srgb_profile" ] || srgb_profile=$(find_srgb_profile)
        magick "$input" -auto-orient \
          -profile "$srgb_profile" \
          -filter Lanczos -resize "${max_width}x>" \
          -background white -alpha remove -alpha off \
          -strip -depth 8 ppm:- |
          "$mozjpeg" -quality 85 -progressive -optimize -sample 2x2 \
            -outfile "$optimized"
      else
        magick "$input" -auto-orient \
          -colorspace sRGB \
          -filter Lanczos -resize "${max_width}x>" \
          -background white -alpha remove -alpha off \
          -strip -depth 8 ppm:- |
          "$mozjpeg" -quality 85 -progressive -optimize -sample 2x2 \
            -outfile "$optimized"
      fi
      ;;
  esac

  output_dimensions=$(magick identify -ping -format '%wx%h' "$optimized")
  output_size=$(wc -c <"$optimized" | tr -d ' ')
  mv "$optimized" "$output"

  printf '%s -> %s: %sx%s -> %s, %s -> %s bytes\n' \
    "$input" "$output" "$input_width" "$input_height" "$output_dimensions" \
    "$input_size" "$output_size"
done
