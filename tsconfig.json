{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.mjs",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.mjs",
    "themes/shsh/assets/ts/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "tests/baseline",
    ".cache",
    "mock",
    "content",
    "themes/PaperMod",
    "public",
    "resources"
  ]
}
